+    /// **3D-0 spike `#[func]`, WORKTREE ONLY, never committed**
+    /// (`3D_VIEWPORT_SCOPE.md` 3D-0(b)). One plain deep-zoom tile as
+    /// `{rgba: Image RGBA8 w×h, height: Image RF (w+2pad)×(h+2pad), w, h, pad,
+    /// sea_level, peak_m, map_width_km, build_ms}` -- colour and heights from
+    /// one `tile_heights` call. `build_ms` is this call's own synthesis time on
+    /// the calling thread (snapshot already built). Empty dictionary when the
+    /// tile cannot be synthesised (omit, never a placeholder).
+    #[func]
+    fn td0_tile_with_heights(&self, z: i32, col: i32, row: i32) -> VarDictionary {
+        let Some(snap) = self.lod_snapshot() else { return VarDictionary::new() };
+        let t0 = std::time::Instant::now();
+        let Some((rgba, w, h, hts, pad, sea, peak)) = snap.td0_render_tile_with_heights(z, col, row) else { return VarDictionary::new() };
+        let build_ms = t0.elapsed().as_secs_f64() * 1000.0;
+        let Some(img) = Image::create_from_data(w as i32, h as i32, false, Format::RGBA8, &PackedByteArray::from(rgba)) else { return VarDictionary::new() };
+        let hb: Vec<u8> = hts.iter().flat_map(|v| v.to_le_bytes()).collect();
+        let (pw, ph) = ((w + 2 * pad) as i32, (h + 2 * pad) as i32);
+        let Some(himg) = Image::create_from_data(pw, ph, false, Format::RF, &PackedByteArray::from(hb)) else { return VarDictionary::new() };
+        // The tile's coarse-cell footprint: pixel 0 sits at `tb.x`, pixel
+        // `w - 1` at `tb.x + tb.w` (`synthesize_tile_rgba_with_z_base`'s map).
+        let Some(tb) = lod_bridge::tile_bounds(self.gw as usize, self.gh as usize, z, col, row) else { return VarDictionary::new() };
+        dict! {
+            "tb_x" => tb.x, "tb_y" => tb.y, "tb_w" => tb.w, "tb_h" => tb.h,
+            "rgba" => &img, "height" => &himg, "w" => w as i64, "h" => h as i64, "pad" => pad as i64,
+            "sea_level" => sea, "peak_m" => peak, "map_width_km" => self.map_width_km, "build_ms" => build_ms,
+        }
+    }
