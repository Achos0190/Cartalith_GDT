+/// **3D-0 spike accessor -- WORKTREE ONLY, never committed**
+/// (`3D_VIEWPORT_SCOPE.md` §5, 3D-0(b): "heights taken through a temporary
+/// engine accessor beside `tile_heights` (worktree only)").
+///
+/// What it does: one call returns the plain (`conform == 0`) colour tile
+/// AND the padded shading heights it was coloured from, so a 3D surface and
+/// its drape come from one `TileHeights` (§3.1's guarantee 1). The colour half
+/// is [`synthesize_tile_rgba_with_z_base`]'s `conform == 0` body, restated
+/// rather than called because that function drops the heights; it must never
+/// diverge from it, which is why it is a spike and not a shipped seam (3D-3
+/// makes `LodSnapshot` return both from one job properly).
+///
+/// Returns `(rgba, w, h, heights, pad)`: `heights` is `(w + 2·pad) × (h +
+/// 2·pad)` normalised `f32`, row-major, core at `(pad, pad)`.
+#[allow(clippy::too_many_arguments, clippy::type_complexity)]
+pub(crate) fn td0_tile_rgba_and_heights(
+    ctx: &RenderCtx,
+    tf: &TileFields,
+    z: i32,
+    col: i32,
+    row: i32,
+    seed: i32,
+    rivers: Option<&crate::river_stroke::RiverGeometry>,
+    fans: Option<&crate::river_stroke::RiverGeometry>,
+    paint: Option<&crate::river_field::PaintSource>,
+) -> Option<(Vec<u8>, usize, usize, Vec<f32>, usize)> {
+    let t = tile_heights(ctx, tf, z, col, row, seed, z_base(), 0)?;
+    let layer = rivers.map(|g| {
+        let cx = t.tb.w / (t.w.max(2) - 1) as f64;
+        let cy = t.tb.h / (t.h.max(2) - 1) as f64;
+        let map = crate::river_stroke::RasterMap::tile(t.tb.x, t.tb.y, cx, cy);
+        match paint {
+            Some(p) => p.raster(map, t.w, t.h),
+            None => crate::river_stroke::rasterize_with(g, fans, ctx.appearance(), t.w, t.h, map),
+        }
+    });
+    let rgba = render::render_biome_tile_rgba_water(ctx, &t.tile, t.water.as_deref(), t.w, t.h, t.pad, t.tb, tf, layer.as_ref());
+    if rgba.len() != t.w * t.h * 4 {
+        return None;
+    }
+    Some((rgba, t.w, t.h, t.tile, t.pad))
+}
