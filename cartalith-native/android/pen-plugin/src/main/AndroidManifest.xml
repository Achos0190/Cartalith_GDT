<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into the app by Gradle. BLUETOOTH_CONNECT is DECLARED here but only REQUESTED at run time, when the user
     switches Pen link on (Ruling EK). No BLUETOOTH_SCAN and no location: the pen is bonded by OnePlus's own
     pairing, so Cartalith never scans. BLE is optional so a device without it is not excluded by the store. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <application>
        <meta-data
            android:name="org.godotengine.plugin.v2.CartalithPen"
            android:value="org.cartalith.pen.CartalithPenPlugin" />
        <!-- NOTE: the provider is the CartalithShareProvider subclass, not FileProvider itself: Godot's template declares
             androidx.core.content.FileProvider and a second one fails the manifest merge (authorities, FILE_PROVIDER_PATHS).
             File ▸ Share project…: serves the copied project .zip to the share sheet's receiver as a content://
             uri (no file:// uri may leave the app since API 24). Not exported; read access is granted per intent
             (FLAG_GRANT_READ_URI_PERMISSION), never globally. The authority equals the one
             CartalithPenPlugin.share_file builds from the package name. The pen plugin carries this rather than a
             second plugin because Godot's template must not be hand-edited and one more .aar is one more thing to
             keep in addons/; the plugin is otherwise read-only, and share_file runs only when a person taps Share. -->
        <provider
            android:name="org.cartalith.pen.CartalithShareProvider"
            android:authorities="${applicationId}.cartalith.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/cartalith_share_paths" />
        </provider>
    </application>
</manifest>
