func _reference() -> void:
	print("== J. the keyboard reference ==")
	var help: PopupMenu = _menu_button("☰").get_popup() if _mode == "tablet" else _menu_button("Help").get_popup()
	help.id_pressed.emit(72)
	await _settle(6)
	var sd = _app.shortcuts_dialog
	_ok(sd != null and sd.visible and sd.title == "Keyboard reference", "Help's row opens the dialog titled Keyboard reference (got '%s')" % (sd.title if sd != null else "none"))
	var listed: Array = sd._collect_from_menus()
	for t in ["Context card", "Cartwheel at the pointer"]:
		_ok(listed.any(func(e): return String(e[2]) == t), "the reference lists Edit ▸ %s" % t)
	_ok(ShortcutsDialog.UNLISTED.any(func(r): return String(r[1]) == "Menu"), "the not-on-a-menu table lists the Menu key")
	await _shot("keyboard_reference")
	sd.hide()
	await _settle(3)
	sd.open_editable()
	await _settle(4)
	_ok(sd.title == "Keyboard shortcuts", "the editor is titled Keyboard shortcuts (got '%s')" % sd.title)
	sd.hide()
	await _settle(2)


