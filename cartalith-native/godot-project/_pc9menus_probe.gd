# -- I ----------------------------------------------------------------------------------------

func _keys() -> void:
	print("== I. keys ==")
	## Ctrl+R: the row's own accelerator. A small world, so the run is short.
	var nw = _app.new_world_dialog
	if nw != null and nw.get("grid_w_input") != null:
		(nw.grid_w_input as SpinBox).set_value_no_signal(256)
	var started := [false]
	_bridge.generation_started.connect(func(): started[0] = true, CONNECT_ONE_SHOT)
	await _move_to(get_viewport().get_visible_rect().get_center())
	await _key(KEY_R, true)
	await _settle(4)
	_ok(started[0], "Ctrl+R starts a generation (File ▸ Generate world's key)")
	var t0 := Time.get_ticks_msec()
	while (bool(_bridge.generating) or not bool(_bridge.has_world)) and Time.get_ticks_msec() - t0 < 240000:
		await _settle(10)
	_ok(bool(_bridge.has_world) and not bool(_bridge.generating), "the generation finished with a world")
	await _settle(30)
	var cb = _app.context_broker
	var map_at: Vector2 = (_app.viewport as Control).get_global_rect().get_center()
	await _move_to(map_at)
	## Q over the map: the press is Edit ▸ Cartwheel at the pointer's accelerator now.
	await _key(KEY_Q, false, false, false, "down")
	_ok(cb != null and cb.ring_is_open(), "Q pressed over the map opens the cartwheel")
	await _shot("cartwheel")
	await _key(KEY_Q, false, false, false, "up")
	await _settle(4)
	if cb.ring_is_open():
		cb.ring_close()
		await _settle(3)
	## Q typed into a field: the row's handler drops a key typed while a text field has focus.
	var field := LineEdit.new()
	_app.add_child(field)
	field.position = Vector2(10, 300)
	field.size = Vector2(200, 30)
	await _settle(2)
	field.grab_focus()
	await _settle(2)
	await _key(KEY_Q, false, false, false, "down")
	_ok(not cb.ring_is_open(), "Q typed into a focused field opens no cartwheel")
	await _key(KEY_Q, false, false, false, "up")
	_ok(field.text == "q" or field.text == "Q" or field.text == "", "the field kept the letter (text '%s')" % field.text)
	field.release_focus()
	field.queue_free()
	await _settle(3)
	if cb.ring_is_open():
		cb.ring_close()
	## Shift+F10: Edit ▸ Context card's accelerator.
	await _move_to(map_at)
	await _key(KEY_F10, false, true)
	await _settle(4)
	_ok(cb.card != null and cb.card.visible, "Shift+F10 over the map opens the context card")
	await _shot("context_card")
	if cb.card != null and cb.card.visible:
		cb.card.hide()
		await _settle(3)
	## Ctrl+Shift+F and Ctrl+Shift+V.
	await _key(KEY_F, true, true)
	await _settle(6)
	_ok(_app.faction_roster_window != null and _app.faction_roster_window.visible, "Ctrl+Shift+F opens the Factions window")
	await _shot("factions")
	if _app.faction_roster_window != null:
		_app.faction_roster_window.hide()
	await _settle(3)
	await _key(KEY_V, true, true)
	await _settle(6)
	_ok(_app.vault_window != null and _app.vault_window.visible, "Ctrl+Shift+V opens the Markdown vault")
	if _app.vault_window != null:
		_app.vault_window.hide()
	await _settle(3)


