extends Node
## PC-9 probe: the PC shell's menus and keys (`PC_SHELL_PROPOSAL.md` §3.8, §3.9 and §3.12;
## Rulings DX, DY and DZ, owner 2026-11-01), inside the real shell, with real mouse clicks on the
## menu bar and real key events through `Input.parse_input_event()`.
##
##   desktop: godot --path . --resolution 1600x1000 _pc9menus_probe.tscn -- --shots <dir>
##   tablet:  godot --path . --resolution 1024x768  _pc9menus_probe.tscn -- --force-touch --shots <dir>   (the short bar, below 1 180 dp: MS-7)
##   wide tablet: godot --path . --resolution 1280x800  _pc9menus_probe.tscn -- --force-touch --shots <dir>   (the whole bar, read as desktop)
##   phone:   godot --path . --resolution 393x852   _pc9menus_probe.tscn -- --force-touch --shots <dir>
##
## **Windowed, never `--headless`**: it clicks the bar through the input system and captures the
## framebuffer. Run it from a project copy with its own `config/name` and a wiped
## `app_userdata/<name>` (`MISTAKES.md`: a probe that reads `user://` can be green for reasons that
## have nothing to do with the code; a stored rebind would move Q). The arguments read are
## `--force-touch` and `--shots <dir>`; anything else aborts with exit 2.
##
## What it protects (PC-9's bar, and PC-11's for the tool-options bar). Every expected title, row
## and key is written here as a literal, never read back from `menus.gd`, so a renamed row, a
## dropped key or a reordered menu fails here:
##   A. BAR: the titles, in order (desktop File · Edit · Assets · Records · Story · Preferences ·
##      Window · Help; tablet ☰ · File · World · Records · Story); every title drawn inside the bar's
##      visible rect with no two overlapping; switching menus on hover on the desktop only.
##   B. FILE (opened by a real click): Generate world · Ctrl+R directly after New world… on the
##      desktop and phone, and absent from File on the tablet, whose World holds it first.
##   C. RECORDS (real click): Factions… · Ctrl+Shift+F, Markdown vault… · Ctrl+Shift+V, the Timeline
##      signpost, and no row titled Generate world.
##   D. EDIT (the bar's on desktop, ☰ ▸ Edit on the tablet): Previous / Next selection after
##      Deselect, disabled with a reason naming PC-1 until it is built, then live on Alt+← / Alt+→; Context card · Shift+F10 and Cartwheel at the
##      pointer · Q directly after Find on map…; neither map row on the phone.
##   E. WINDOW: the region row reads Context panel since PC-4 (it read Right dock before), then the
##      Context panel submenu: five rows, a MODULES band of ten and Reset panel on desktop and tablet
##      (five and no band on the phone); since PC-4, Inspect, Pin, Follow and Reset panel are live
##      with tooltips, and since PC-5, PC-6 and PC-10 Note, Ask and the ten modules are too.
##   F. STORY / HELP / ASSETS: Story's NOTES band signposts Records; Help reads Keyboard
##      reference…; Assets has no Import image… row.
##   G. SEARCH, by TITLE (`MISTAKES.md`, "Move a command off the menu bar"): "Import image",
##      "Run pipeline" (desktop) and "Records (was World)" each appear once; "Right dock" appears once
##      as its alias since PC-4 renamed the row; "Notes for this place" appears once, as its alias, since
##      PC-5 renamed the live row Note for the selection.
##   H. COLLISIONS: no accelerator is carried by two different command ids anywhere on the bar.
##   I. KEYS (desktop and tablet, a world generated by Ctrl+R itself): Ctrl+R starts a generation;
##      Q over the map opens the cartwheel and its release closes it; Q typed into a focused field
##      opens nothing; Shift+F10 opens the context card; Ctrl+Shift+F opens the Factions window;
##      Ctrl+Shift+V opens the vault.
##   J. REFERENCE: Help ▸ Keyboard reference… (opened through the popup's own `id_pressed`) titles
##      the window "Keyboard reference" and lists Edit ▸ Context card and Edit ▸ Cartwheel at the
##      pointer; the "Menu" key is in its not-on-a-menu table; the editor is titled "Keyboard
##      shortcuts".
##   K. PC-11: WORLD's idle tool-options row holds no Button, its context label and its one hint.
##   L. PHONE: the hidden menu model carries Records, not World; the MORE data screen finds the
##      Records menu by its title and draws its rows.
## Result: `RESULT: PASS|FAIL (<n> failed, <m> checks)`. Exit 0 pass, 1 fail, 2 bad argument or
## watchdog, 3 when the checks held but the bar overflowed the window (its own exit code, so a
## surface failure is never reported as a pass: `MISTAKES.md`, "Write or accept a probe's exit
## status").

var _fails := 0
var _checks := 0
var _overflow := false
var _mode := "desktop"
var _shots := ""
var _app: Node
var _bridge


func _ok(cond: bool, what: String) -> void:
	_checks += 1
	print(("  ok    " if cond else "  FAIL  ") + what)
	if not cond:
		_fails += 1


func _settle(frames: int = 4) -> void:
	for _i in frames:
		await get_tree().process_frame


func _shot(tag: String) -> void:
	if _shots == "":
		return
	await _settle(3)
	await RenderingServer.frame_post_draw
	var img := get_viewport().get_texture().get_image()
	if img == null:
		_ok(false, "capture %s returned an image" % tag)
		return
	var path := _shots.path_join("pc9_%s_%s.png" % [_mode, tag])
	img.save_png(path)
	print("SHOT %s" % path)


func _finish() -> void:
	print("RESULT: %s (%d failed, %d checks)" % ["PASS" if _fails == 0 else "FAIL", _fails, _checks])
	if _fails == 0 and _overflow:
		print("RESULT: the checks held but the bar overflowed the window (exit 3)")
		get_tree().quit(3)
		return
	get_tree().quit(0 if _fails == 0 else 1)


## A REAL mouse motion, press and release at the viewport point `at`, through the input system.
func _click_at(at: Vector2) -> void:
	var mm := InputEventMouseMotion.new()
	mm.position = at
	mm.global_position = at
	mm.relative = Vector2(0, 2)
	Input.parse_input_event(mm)
	await _settle(2)
	for down in [true, false]:
		var ev := InputEventMouseButton.new()
		ev.button_index = MOUSE_BUTTON_LEFT
		ev.pressed = down
		ev.position = at
		ev.global_position = at
		Input.parse_input_event(ev)
		await _settle(2)
	await _settle(3)


## A REAL mouse motion only (the pointer moves over the map, so `last_mouse_pos()` is there).
func _move_to(at: Vector2) -> void:
	var mm := InputEventMouseMotion.new()
	mm.position = at
	mm.global_position = at
	mm.relative = Vector2(2, 2)
	Input.parse_input_event(mm)
	await _settle(3)


## A REAL key event: `down` only, `up` only, or both, with modifiers.
func _key(code: Key, ctrl := false, shift := false, alt := false, phase := "both") -> void:
	var phases: Array = [true, false] if phase == "both" else ([true] if phase == "down" else [false])
	for down in phases:
		var ev := InputEventKey.new()
		ev.keycode = code
		ev.physical_keycode = code
		ev.pressed = down
		ev.ctrl_pressed = ctrl
		ev.shift_pressed = shift
		ev.alt_pressed = alt
		Input.parse_input_event(ev)
		await _settle(2)
	await _settle(3)


func _menu_button(title: String) -> MenuButton:
	for ch in _app.menu_bar_row.get_children():
		if ch is MenuButton and (ch as MenuButton).text == title:
			return ch
	return null


func _titles() -> Array:
	var out: Array = []
	for ch in _app.menu_bar_row.get_children():
		if ch is MenuButton:
			out.append((ch as MenuButton).text)
	return out


func _index_of(p: PopupMenu, text: String) -> int:
	for i in p.item_count:
		if not p.is_item_separator(i) and p.get_item_text(i) == text:
			return i
	return -1


## The submenu row titled `title`. Since PC-4 Window carries two rows titled Context panel (the region
## check, then the submenu: a `PopupMenu` row cannot be both), so this takes the row that HAS a submenu.
func _sub(p: PopupMenu, title: String) -> PopupMenu:
	for i in p.item_count:
		if not p.is_item_separator(i) and p.get_item_text(i) == title and p.get_item_submenu(i) != "":
			return p.get_node_or_null(NodePath(p.get_item_submenu(i))) as PopupMenu
	return null


## Rows that are not separators, as text.
func _texts(p: PopupMenu) -> Array:
	var out: Array = []
	for i in p.item_count:
		if not p.is_item_separator(i):
			out.append(p.get_item_text(i))
	return out


## Opens bar menu `title` with a real click on its MenuButton; returns its popup, visible.
func _open_by_click(title: String) -> PopupMenu:
	var mb := _menu_button(title)
	if mb == null:
		return null
	await _click_at(mb.get_global_rect().get_center())
	await _settle(3)
	return mb.get_popup()


func _close_menus() -> void:
	for ch in _app.menu_bar_row.get_children():
		if ch is MenuButton and (ch as MenuButton).get_popup().visible:
			(ch as MenuButton).get_popup().hide()
	await _settle(3)


## The popup that holds Edit's rows on this form factor: the bar's Edit, or ☰ ▸ Edit on the tablet.
func _edit_popup() -> PopupMenu:
	if _mode == "tablet":
		var ov := _menu_button("☰")
		return _sub(ov.get_popup(), "Edit") if ov != null else null
	var mb := _menu_button("Edit")
	return mb.get_popup() if mb != null else null


func _window_popup() -> PopupMenu:
	if _mode == "tablet":
		var ov := _menu_button("☰")
		return _sub(ov.get_popup(), "Window") if ov != null else null
	var mb := _menu_button("Window")
	return mb.get_popup() if mb != null else null


func _ready() -> void:
	var args := OS.get_cmdline_user_args()
	var i := 0
	while i < args.size():
		var a := args[i]
		if a == "--force-touch":
			pass
		elif a == "--shots" and i + 1 < args.size():
			i += 1
			_shots = args[i]
		else:
			print("ABORT: unrecognised argument %s -- this probe reads --force-touch and --shots <dir> only" % a)
			get_tree().quit(2)
			return
		i += 1
	get_tree().create_timer(600.0).timeout.connect(func() -> void:
		print("WATCHDOG: the probe did not finish")
		get_tree().quit(2))
	if _shots != "":
		DirAccess.make_dir_recursive_absolute(_shots)
	if not ClassDB.class_exists("WorldGen"):
		print("[FATAL] extension did not load")
		get_tree().quit(2)
		return
	## A wiped user dir has no stored rebinds; a stored one would move Q and the other keys.
	_ok(DccSettings.shortcut_binding(DccSettings.SHORTCUT_CONTEXT_MENU, 913, KEY_Q) == KEY_Q,
		"no stored rebind of the cartwheel row (the user dir was wiped)")
	_app = load("res://shell/app.tscn").instantiate()
	add_child(_app)
	await get_tree().create_timer(1.2).timeout
	if _app.open_project_dialog:
		_app.open_project_dialog.hide()
	await _settle(6)
	## MS-7: `_mode == "tablet"` means the tablet's SHORT bar (`☰ · File · World · Records · Story`), which a touch
	## window shows below 1 180 dp. A tablet from 1 180 dp draws the PC's eight menus whole, and is read here as
	## "desktop" (the bar and its rows are the PC's; the legs that only a pointer can run check `_touch`).
	## Run the short bar at `--resolution 1024x768 --force-touch`, the whole bar at 1280x800 or 1600x1000.
	var whole_bar: bool = DccTheme.tablet_bar_whole(float(DccTheme.layout().get("dp", Vector2.ZERO).x))
	_mode = "phone" if _app.is_phone() else ("tablet" if DccTheme.is_tablet() and not whole_bar else "desktop")
	print("== mode %s, viewport %s ==" % [_mode, get_viewport().get_visible_rect().size])
	_bridge = _app.bridge
	if _mode == "phone":
		await _phone()
		_finish()
		return
	await _bar()
	await _file()
	await _records()
	await _edit()
	await _window()
	await _story_help_assets()
	_search()
	_collisions()
	_tool_options()
	await _keys()
	await _reference()
	_finish()


# -- A ----------------------------------------------------------------------------------------

func _bar() -> void:
	print("== A. the bar ==")
	var want: Array = ["☰", "File", "World", "Records", "Story"] if _mode == "tablet" \
		else ["File", "Edit", "Assets", "Records", "Story", "Preferences", "Window", "Help"]
	_ok(_titles() == want, "the bar reads %s (got %s)" % [str(want), str(_titles())])
	var row_rect: Rect2 = (_app.menu_bar_row as Control).get_global_rect()
	var vis := get_viewport().get_visible_rect()
	var prev_end := -INF
	for ch in _app.menu_bar_row.get_children():
		if not (ch is MenuButton):
			continue
		var r: Rect2 = (ch as Control).get_global_rect()
		var inside := r.position.x >= vis.position.x and r.end.x <= vis.end.x and row_rect.encloses(r)
		if not inside:
			_overflow = true
		_ok(inside, "'%s' is drawn inside the bar and the window (rect %s, row %s)" % [(ch as MenuButton).text, str(r), str(row_rect)])
		_ok(r.position.x >= prev_end - 0.5, "'%s' does not overlap the title before it" % (ch as MenuButton).text)
		prev_end = r.end.x
		## MS-7: a wide touch tablet reads as "desktop" here, and has no hover (`switch_on_hover` is `not _touch`).
		_ok((ch as MenuButton).switch_on_hover == (_mode == "desktop" and not DccTheme.is_touch()),
			"'%s' switches on hover only on the desktop (got %s)" % [(ch as MenuButton).text, str((ch as MenuButton).switch_on_hover)])
	await _shot("bar")


# -- B ----------------------------------------------------------------------------------------

func _file() -> void:
	print("== B. File ==")
	var p := await _open_by_click("File")
	_ok(p != null and p.visible, "a real click on File opens it")
	if p == null:
		return
	var rows := _texts(p)
	if _mode == "tablet":
		_ok(not rows.has("Generate world"), "the tablet's File has no Generate world row (its World holds it)")
		await _close_menus()
		var w := await _open_by_click("World")
		_ok(w != null and w.visible, "a real click on World opens it (tablet)")
		if w != null:
			var wr := _texts(w)
			_ok(wr == ["Generate world", "Reset generation parameters", "Reset one stage", "Generation pipeline", "Sculpt", "Seed & size…"],
				"the tablet's World holds the WORLD domain's rows only, Generate world first (got %s)" % str(wr))
			var gi := _index_of(w, "Generate world")
			_ok(gi >= 0 and w.get_item_accelerator(gi) == (KEY_MASK_CTRL | KEY_R) and w.get_item_id(gi) == 710,
				"World ▸ Generate world is id 710 on Ctrl+R")
			await _shot("world")
	else:
		var ni := rows.find("New world…")
		_ok(ni >= 0 and ni + 1 < rows.size() and rows[ni + 1] == "Generate world",
			"File's row after New world… is Generate world (got %s)" % str(rows.slice(0, 4)))
		var gi := _index_of(p, "Generate world")
		_ok(gi >= 0 and p.get_item_accelerator(gi) == (KEY_MASK_CTRL | KEY_R) and p.get_item_id(gi) == 710,
			"File ▸ Generate world is id 710 on Ctrl+R")
		_ok(_index_of(p, "imports live under Records ▸ Import") >= 0, "File's signpost names Records ▸ Import")
		await _shot("file")
	await _close_menus()


# -- C ----------------------------------------------------------------------------------------

func _records() -> void:
	print("== C. Records ==")
	var p := await _open_by_click("Records")
	_ok(p != null and p.visible, "a real click on Records opens it")
	if p == null:
		return
	var fi := _index_of(p, "Factions…")
	_ok(fi >= 0 and p.get_item_accelerator(fi) == (KEY_MASK_CTRL | KEY_MASK_SHIFT | KEY_F),
		"Records ▸ Factions… carries Ctrl+Shift+F")
	var vi := _index_of(p, "Markdown vault…")
	_ok(vi >= 0 and p.get_item_accelerator(vi) == (KEY_MASK_CTRL | KEY_MASK_SHIFT | KEY_V),
		"Records ▸ Markdown vault… carries Ctrl+Shift+V")
	var ti := _index_of(p, "Timeline is in Story ▸ Timeline")
	_ok(ti >= 0 and p.is_item_disabled(ti), "Records' Timeline row is the disabled signpost")
	_ok(_index_of(p, "Timeline") < 0, "no live Timeline row is left in Records")
	_ok(_index_of(p, "Generate world") < 0, "Records holds no Generate world row (it is File's)")
	await _shot("records")
	await _close_menus()


# -- D ----------------------------------------------------------------------------------------

func _edit() -> void:
	print("== D. Edit ==")
	if _mode == "desktop":
		var opened := await _open_by_click("Edit")
		_ok(opened != null and opened.visible, "a real click on Edit opens it")
	var p := _edit_popup()
	_ok(p != null, "the Edit rows exist (%s)" % ("☰ ▸ Edit" if _mode == "tablet" else "Edit"))
	if p == null:
		return
	var rows := _texts(p)
	var di := rows.find("Deselect")
	_ok(di >= 0 and di + 2 < rows.size() and rows[di + 1] == "Previous selection" and rows[di + 2] == "Next selection",
		"Previous / Next selection follow Deselect (got %s)" % str(rows.slice(maxi(di, 0), di + 3)))
	## Two forms (draft 03): a `_todo` naming PC-1 before it, live on Alt+← / Alt+→ from it.
	var pc1 := _app.has_method("select_back")
	for e in [["Previous selection", KEY_MASK_ALT | KEY_LEFT, 910], ["Next selection", KEY_MASK_ALT | KEY_RIGHT, 911]]:
		var i := _index_of(p, String(e[0]))
		if pc1:
			_ok(i >= 0 and not p.is_item_disabled(i) and p.get_item_accelerator(i) == int(e[1]) and p.get_item_id(i) == int(e[2]),
				"%s is live (PC-1 built) on %s, id %d" % [e[0], OS.get_keycode_string(int(e[1])), int(e[2])])
		else:
			_ok(i >= 0 and p.is_item_disabled(i) and p.get_item_tooltip(i).contains("PC-1"),
				"%s is disabled until PC-1, with a reason naming it" % e[0])
	var fi := rows.find("Find on map…")
	_ok(fi >= 0 and fi + 2 < rows.size() and rows[fi + 1] == "Context card" and rows[fi + 2] == "Cartwheel at the pointer",
		"Context card and Cartwheel at the pointer follow Find on map… (got %s)" % str(rows.slice(maxi(fi, 0), fi + 3)))
	var ci := _index_of(p, "Context card")
	_ok(ci >= 0 and p.get_item_accelerator(ci) == (KEY_MASK_SHIFT | KEY_F10) and p.get_item_id(ci) == 912,
		"Edit ▸ Context card is id 912 on Shift+F10")
	var qi := _index_of(p, "Cartwheel at the pointer")
	_ok(qi >= 0 and p.get_item_accelerator(qi) == KEY_Q and p.get_item_id(qi) == 913,
		"Edit ▸ Cartwheel at the pointer is id 913 on Q")
	_ok(_app.menus.is_rebindable_shortcut(912) and _app.menus.is_rebindable_shortcut(913),
		"both rows' keys are rebindable (they went through _bind_accelerator)")
	if _mode == "desktop":
		await _shot("edit")
	await _close_menus()


# -- E ----------------------------------------------------------------------------------------

func _window() -> void:
	print("== E. Window ==")
	if _mode == "desktop":
		var opened := await _open_by_click("Window")
		_ok(opened != null and opened.visible, "a real click on Window opens it")
	var p := _window_popup()
	_ok(p != null, "the Window rows exist")
	if p == null:
		return
	var rows := _texts(p)
	var ri := rows.find("Context panel")
	_ok(ri >= 0 and ri + 1 < rows.size() and rows[ri + 1] == "Context panel" and not rows.has("Right dock"),
		"the region row reads Context panel (PC-4) and its submenu sits directly under it (got %s)" % str(rows.slice(maxi(ri, 0), ri + 2)))
	var sub := _sub(p, "Context panel")
	_ok(sub != null, "Window ▸ Context panel is a submenu")
	if sub == null:
		await _close_menus()
		return
	var want: Array = ["Inspect", "Note", "Ask (assistant)", "Pin to the current subject", "Follow the selection",
		"History", "Economy", "Military", "Faith, culture & relations", "Territory", "City layout", "Here",
		"Routes & journeys", "Links", "Recent & bookmarks", "Reset panel"]
	_ok(_texts(sub) == want, "Context panel's rows are the mockup's five, ten modules and Reset panel (got %s)" % str(_texts(sub)))
	## PC-4 built Inspect, Pin, Follow and Reset panel, PC-6 Ask and PC-10 the ten modules: live, each with
	## its tooltip (a module row is a check row; `_pc10modules_probe` drives them). PC-5 built Note, so it is live
	## too and no row is disabled any more.
	var live_rows := ["Inspect", "Note", "Ask (assistant)", "Pin to the current subject", "Follow the selection",
		"History", "Economy", "Military", "Faith, culture & relations", "Territory", "City layout", "Here",
		"Routes & journeys", "Links", "Recent & bookmarks", "Reset panel"]
	var silent: Array = []
	for i in sub.item_count:
		if sub.is_item_separator(i):
			continue
		var t := sub.get_item_text(i)
		var want_live := live_rows.has(t)
		if sub.is_item_disabled(i) == want_live or sub.get_item_tooltip(i).strip_edges() == "":
			silent.append(t)
	_ok(silent.is_empty(), "Context panel: the PC-4, PC-5, PC-6 and PC-10 rows are live and every other row is disabled with a reason (offenders %s)" % str(silent))
	var has_modules := false
	for i in sub.item_count:
		if sub.is_item_separator(i) and sub.get_item_text(i) == "MODULES":
			has_modules = true
	_ok(has_modules, "the MODULES band is drawn")
	if _mode == "desktop":
		var pos := Vector2i(int(p.position.x + p.size.x), int(p.position.y))
		sub.popup(Rect2i(pos, Vector2i.ZERO))
		await _settle(4)
		await _shot("window_context_panel")
	await _close_menus()
	sub.hide()


# -- F ----------------------------------------------------------------------------------------

func _story_help_assets() -> void:
	print("== F. Story, Help, Assets ==")
	var story := await _open_by_click("Story")
	_ok(story != null and story.visible, "a real click on Story opens it")
	if story != null:
		var si := _index_of(story, "Places without notes is in Records")
		_ok(si >= 0 and story.is_item_disabled(si), "Story's NOTES band signposts Records' Places without notes…")
		_ok(_index_of(story, "Places without notes…") < 0, "Story has no second Places without notes… row")
		await _shot("story")
	await _close_menus()
	var help: PopupMenu = null
	var assets: PopupMenu = null
	if _mode == "tablet":
		var ov := _menu_button("☰")
		help = ov.get_popup() if ov != null else null
		assets = _sub(help, "Assets") if help != null else null
	else:
		help = (await _open_by_click("Help"))
		await _close_menus()
		assets = (await _open_by_click("Assets"))
	_ok(help != null and _index_of(help, "Keyboard reference…") >= 0 and _index_of(help, "Keyboard shortcuts…") < 0,
		"Help's read-only row reads Keyboard reference…")
	_ok(assets != null and _index_of(assets, "Import image…") < 0 and _index_of(assets, "⧉ Sprite sheet slicer (▦)") >= 0,
		"Assets has no Import image… row (and still has its slicer)")
	await _close_menus()


# -- G ----------------------------------------------------------------------------------------

func _search() -> void:
	print("== G. search, by title ==")
	var idx := CommandIndex.new()
	idx.build(_app, _bridge)
	var count := func(t: String) -> int:
		var n := 0
		for r in idx.all():
			if String(r["title"]) == t:
				n += 1
		return n
	_ok(count.call("Import image") == 1, "\"Import image\" is found by title once (its alias)")
	_ok(count.call("Records (was World)") == 1, "\"Records (was World)\" is found by title once")
	## The tablet's World row and the desktop's File row are titled Generate world now, so the
	## old words survive only as the alias, on every form factor (Ruling DX PQ11).
	_ok(count.call("Run pipeline") == 1, "\"Run pipeline\" is found by title once (its alias)")
	_ok(count.call("Right dock") == 1, "\"Right dock\" is found once: its alias, since PC-4 renamed the live row Context panel")
	_ok(count.call("Notes for this place") == 1, "\"Notes for this place\" is found once: its alias, since PC-5 renamed the live row Note for the selection")


# -- H ----------------------------------------------------------------------------------------

func _walk(p: PopupMenu, path: String, out: Array) -> void:
	for i in p.item_count:
		if p.is_item_separator(i):
			continue
		var sub_name := p.get_item_submenu(i)
		if sub_name != "":
			var s := p.get_node_or_null(NodePath(sub_name)) as PopupMenu
			if s != null:
				_walk(s, path + " > " + p.get_item_text(i), out)
			continue
		var acc := p.get_item_accelerator(i)
		if acc != 0:
			out.append([acc, p.get_item_id(i), path + " > " + p.get_item_text(i)])


## Every row id >= 900 under `p`, at every depth: id -> {title: true}.
func _ids(p: PopupMenu, out: Dictionary) -> void:
	for i in p.item_count:
		if p.is_item_separator(i):
			continue
		var sub_name := p.get_item_submenu(i)
		if sub_name != "":
			var s := p.get_node_or_null(NodePath(sub_name)) as PopupMenu
			if s != null:
				_ids(s, out)
			continue
		var id := p.get_item_id(i)
		if id >= 900:
			if not out.has(id):
				out[id] = {}
			(out[id] as Dictionary)[p.get_item_text(i)] = true


func _collisions() -> void:
	print("== H. accelerator collisions ==")
	var all: Array = []
	for ch in _app.menu_bar_row.get_children():
		if ch is MenuButton:
			_walk((ch as MenuButton).get_popup(), (ch as MenuButton).text, all)
	var by_key := {}
	for e in all:
		var k := int(e[0])
		if not by_key.has(k):
			by_key[k] = {}
		(by_key[k] as Dictionary)[int(e[1])] = String(e[2])
	var clashes: Array = []
	for k in by_key:
		if (by_key[k] as Dictionary).size() > 1:
			clashes.append("%s: %s" % [OS.get_keycode_string(k), str((by_key[k] as Dictionary).values())])
	print("  info %d accelerator rows, %d distinct keys" % [all.size(), by_key.size()])
	_ok(clashes.is_empty(), "no key is carried by two different commands (%s)" % str(clashes))
	## Command ids from 900 up (PC-9's 910-934, the assistant's 900-903, MS-1's UI scale 930-933): one id,
	## one command. Lower ids include run-time lists numbered from 0 (Open windows, recent projects),
	## which reuse small ids by design. Caught a real clash on 2026-11-07 (930: Reset panel and UI scale).
	var by_id := {}
	for ch in _app.menu_bar_row.get_children():
		if ch is MenuButton:
			_ids((ch as MenuButton).get_popup(), by_id)
	var id_clash: Array = []
	for id in by_id:
		if (by_id[id] as Dictionary).size() > 1:
			id_clash.append("%d: %s" % [id, str((by_id[id] as Dictionary).keys())])
	_ok(id_clash.is_empty(), "no command id from 900 up names two different rows (%s)" % str(id_clash))
	for want in [KEY_MASK_CTRL | KEY_R, KEY_MASK_CTRL | KEY_MASK_SHIFT | KEY_F, KEY_MASK_CTRL | KEY_MASK_SHIFT | KEY_V,
			KEY_MASK_SHIFT | KEY_F10, KEY_Q]:
		_ok(by_key.has(want), "%s is bound on the bar" % OS.get_keycode_string(want))


