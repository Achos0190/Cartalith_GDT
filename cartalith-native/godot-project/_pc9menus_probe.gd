func _phone() -> void:
	print("== L. phone ==")
	var t := _titles()
	_ok(t.has("Records") and not t.has("World"), "the phone's menu model carries Records, not World (got %s)" % str(t))
	var file := _menu_button("File")
	var rows := _texts(file.get_popup()) if file != null else []
	var ni := rows.find("New world…")
	_ok(ni >= 0 and ni + 1 < rows.size() and rows[ni + 1] == "Generate world", "the phone's File has Generate world after New world…")
	var edit := _menu_button("Edit")
	var er := _texts(edit.get_popup()) if edit != null else []
	_ok(not er.has("Context card") and not er.has("Cartwheel at the pointer"), "the phone's Edit has neither map row (Ruling DX PQ10)")
	var win := _menu_button("Window")
	var sub := _sub(win.get_popup(), "Context panel") if win != null else null
	_ok(sub != null and _texts(sub).size() == 5, "the phone's Window ▸ Context panel has five rows and no MODULES band (got %s)" % (str(_texts(sub)) if sub != null else "none"))
	var pm = _app.get("_phone_menu")
	_ok(pm != null, "the phone has a PhoneMenu")
	if pm != null:
		pm.open()
		await _settle(6)
		var labels: Array = []
		for l in pm._screen_body.find_children("*", "Label", true, false):
			labels.append((l as Label).text)
		for b in pm._screen_body.find_children("*", "Button", true, false):
			labels.append((b as Button).text)
		var joined := " | ".join(PackedStringArray(labels))
		print("  info MORE root: ", joined.substr(0, 600))
		## MS-4: MENU's root is the eight desktop menus, so the old "WORLD" band over Data manager, Asset library,
		## Travel library and Simulation is gone. What PC-9 changed here is the lookup of the menu by title
		## (EDIT W8), now read off the Records popup MENU opens.
		_ok(not joined.contains("World ▸"), "the MORE root names no World ▸ path")
		await _shot("more_root")
		pm._push(pm._menu_popup("Records", false), "Records", pm.SCREEN_LEVEL)
		await _settle(6)
		var data_txt: Array = []
		for l in pm._screen_body.find_children("*", "Label", true, false):
			data_txt.append((l as Label).text)
		for b in pm._screen_body.find_children("*", "Button", true, false):
			data_txt.append((b as Button).text)
		var dj := " | ".join(PackedStringArray(data_txt))
		print("  info MORE data screen: ", dj.substr(0, 600))
		_ok(not dj.contains("The Story menu is not available here"), "MENU's Records popup finds the Records menu (EDIT W8)")
		_ok(dj.contains("Factions"), "the data screen draws Records' rows (Factions…)")
		await _shot("more_data")
		pm.close()
		await _settle(3)
