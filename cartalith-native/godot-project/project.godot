; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Cartalith Terrain Generator"
run/main_scene="res://shell/app.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"

[display]

; ONLY semicolons start a comment in this file. A ## line is NOT a comment --
; the variant parser behind project.godot reads it as data, and a quote or an
; apostrophe inside one opens a string literal that silently swallows every
; key below it to the end of the section, with no error reported. The ##
; block that used to sit here did exactly that. Keep to semicolons.
;
; Section 13: the phone mockup ("DCC shell android phone" in
; design/Cartalith DCC Shell.dc.html) is a 393x852 portrait screen, but this
; key was never effective before now, and the unset default is 0, Landscape --
; which is exactly the "desktop chrome crammed onto the screen" bug the phone
; composition was built to fix. Sensor rather than a fixed Portrait lock,
; because section 13 also specifies a distinct landscape treatment that
; DccShell._landscape / _apply_phone_orientation() implements at runtime;
; locking the OS orientation would make that code unreachable on a device.
;
; 6 is DisplayServer.SCREEN_SENSOR. This key is an int enum in Godot 4, not
; the Godot 3 string it was previously spelled as. The string form is not an
; error -- it resolves to 0, Landscape -- so the exported activity requested
; SCREEN_ORIENTATION_LANDSCAPE, Android never rotated the window,
; root.size_changed never fired, and _apply_phone_orientation() was
; unreachable for the whole life of the build. Verified with dumpsys window
; on the device and with ProjectSettings.get_setting() on the desktop.
; Full write-up in ANDROID_BUILD_SCOPE.md.
;
; Keys are written relative to their section: this is display/window/handheld/
; orientation, spelled window/handheld/orientation under [display].
window/handheld/orientation=6

[gui]

theme/custom="res://theme/dark_theme.tres"

[input_devices]

; Reminder from [display] above: ONLY semicolons start a comment in this file.
;
; Pinch-to-zoom on the phone. `ViewportHost._input()` has handled
; InputEventMagnifyGesture since the camera was written, but on Android that
; event is never produced unless this setting is on: Godot's Android input
; layer only attaches its ScaleGestureDetector/GestureDetector when
; `pan_and_scale_enabled` is set from this key, and the engine default is
; false. So the pinch branch was live code on a macOS trackpad and dead code
; on every phone -- the owner's "zooming doesn't seem to work on the phone".
; Nothing was wrong with the gesture handler; the events never arrived.
;
; Confirmed against this exact engine (4.7.1) rather than assumed:
; ProjectSettings.has_setting() is true and the unset value read back false.
;
; Two-finger only. Single-finger touch still emulates a mouse
; (input_devices/pointing/emulate_mouse_from_touch, default true and left
; alone), so every existing tap/drag/scroll interaction in the shell is
; unaffected -- the gesture detector consumes the two-pointer case only.
pointing/android/enable_pan_and_scale_gestures=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
