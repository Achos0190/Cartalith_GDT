[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.2
reloadable = true

[libraries]
linux.debug.x86_64     = "res://../target/debug/libcartalith_godot.so"
linux.release.x86_64   = "res://../target/release/libcartalith_godot.so"

windows.debug.x86_64   = "res://../target/x86_64-pc-windows-gnu/debug/cartalith_godot.dll"
windows.release.x86_64 = "res://../target/x86_64-pc-windows-gnu/release/cartalith_godot.dll"

android.debug.arm64    = "res://../target/aarch64-linux-android/debug/libcartalith_godot.so"
android.release.arm64  = "res://../target/aarch64-linux-android/release/libcartalith_godot.so"
android.debug.arm32    = "res://../target/armv7-linux-androideabi/debug/libcartalith_godot.so"
android.release.arm32  = "res://../target/armv7-linux-androideabi/release/libcartalith_godot.so"
android.debug.x86_64   = "res://../target/x86_64-linux-android/debug/libcartalith_godot.so"
android.release.x86_64 = "res://../target/x86_64-linux-android/release/libcartalith_godot.so"
