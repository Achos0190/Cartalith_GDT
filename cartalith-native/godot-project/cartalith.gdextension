[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.2
reloadable = true

[libraries]
linux.debug.x86_64     = "res://../target/debug/libcartalith_godot.so"
linux.release.x86_64   = "res://../target/release/libcartalith_godot.so"

windows.debug.x86_64   = "res://../target/debug/cartalith_godot.dll"
windows.release.x86_64 = "res://../target/release/cartalith_godot.dll"

; Android arm64 -- the only Android arch this project actually ships. Each
; path below is refreshed by exactly one command, and NOTHING ELSE writes to
; it. Run the matching command before the matching export, or the export
; silently packages whatever `.so` was last left in that directory:
;
;   android.debug.arm64    cargo ndk -t arm64-v8a build --profile android-dev -p cartalith-godot
;   android.release.arm64  cargo ndk -t arm64-v8a build --release -p cartalith-godot
;
; (`--profile`/`--release` are `cargo build` flags, so they must follow
; `build`, not precede it -- `cargo ndk --profile ...` fails outright.)
;
; This is not hypothetical twice over. `android.debug.arm64` used to point at
; `.../debug/`, which the documented `android-dev` profile never writes, and a
; hand-copied `.so` shipped stale from there (fixed 2026-08-20). Then
; `android.release.arm64` was found on 2026-08-24 still resolving to a
; 2026-08-16 build -- correct path, but no documented step had ever refreshed
; it, so a release export would have shipped eight days of nothing. The
; commands above exist so neither entry can rot again.
;
; NOTE: `;` is the comment character here (ConfigFile). A `#` line is parsed
; as DATA, and an apostrophe inside one opens a string literal that eats every
; key below it with no error -- see ANDROID_BUILD_SCOPE.md's fourth pass §1.
android.debug.arm64    = "res://../target/aarch64-linux-android/android-dev/libcartalith_godot.so"
android.release.arm64  = "res://../target/aarch64-linux-android/release/libcartalith_godot.so"
android.debug.arm32    = "res://../target/armv7-linux-androideabi/debug/libcartalith_godot.so"
android.release.arm32  = "res://../target/armv7-linux-androideabi/release/libcartalith_godot.so"
android.debug.x86_64   = "res://../target/x86_64-linux-android/debug/libcartalith_godot.so"
android.release.x86_64 = "res://../target/x86_64-linux-android/release/libcartalith_godot.so"
