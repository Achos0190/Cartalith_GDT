extends Node
## Protects: ET-F2 (`EDITING_TOOLS_SCOPE.md` section 7; owner Ruling CB item 2) --
## dark, light and pastel variants of every style preset, generated by RULE
## (`render_workspace.gd::VARIANT_RASTER` / `VARIANT_INK` / `variant_appearance()` /
## `variant_treatment_for()`), through the real shell on a real generated world:
##
##   A. RULE. Pure checks, no render: the appearance-key set a preset resets is the
##      base presets' own set (the rule added no key, so look-history snapshots did
##      not grow); `""` and an unknown name return the base treatment; Antique's dark
##      treatment mirrors to a pale ink on a dark halo (OkLab L literals); the light
##      variant's label ink keeps at most 0.35 of its chroma.
##   B. 17 PRESETS x 4 (base + three variants) -- 68 windowed renders, the variants
##      pressed through their own chips. Per variant render: the engine's appearance
##      equals `variant_appearance()` over the BASE render's read-back; the overlay
##      carries `variant_treatment_for()`; the label ink vs halo contrast >= 4.5; every
##      generated class ink vs halo >= 4.5 (`_overlaystyle_probe.gd`'s bar, stricter than
##      the scope's 3.0, which is reported too); the settlement-name pair >= 4.5; the
##      drawn faction set's smallest pairwise CIE76 delta-E >= the guard's own bar
##      `min(20, the raw set's)`; the screenshot moved off the base's. Then the chip is
##      pressed AGAIN and the base must come back (appearance, overlay, lit chip).
##      **Ordering**: mean OkLab L of the map, dark < base < light. The metric is
##      CALIBRATED first (MISTAKES.md "Invent a screening metric"): Default and Night,
##      hand-checked from their saved screenshots as a light and a dark map, are
##      printed in the metric's label and must order Night < Default.
##   C. LOOK COEXISTENCE. With an ET-F1 Look entry (entry 0, `hsl`) on the terrain
##      stack, pressing a variant chip and the base leaves the terrain stack and the
##      overlay stack byte-identical (the rule writes no adjustment entry).
##   D. HISTORY LABEL. After a variant press, Edit > Undo names "Style: <preset>
##      (<Variant>)"; undo relights the previous chip and restores the appearance.
##   E. UNKNOWN VARIANT. `_apply_preset(i, "sepia")` is the base preset.
##
## MUST run WINDOWED, from a SCRATCH COPY of the project (never the live tree: a run
## writes user:// under the copy's own config/name):
##
##   Godot_v4.7.x_win64_console.exe --path <copy> res://_etf2_probe.tscn -- --out DIR
##
## Arguments: --out DIR (required: screenshots + metric table), --seed N (483920),
## --grid WxH (1024x656), --only NAME (one preset, for a quick look).
## Exit 0 = every check held; 1 = a check failed; 2 = could not run (headless, no world,
## fewer than two factions for the faction leg) -- never a pass.
## Result: an assertion with a metric table, windowed only. Command per the header: `res://_etf2_probe.tscn -- --out DIR`
## (`--out` required; `--seed N` default 483920, `--grid WxH` default 1024x656, `--only NAME`). Prints `ETF2  ok
## <what>`, `PROBE-FAIL ETF2  <what>` per miss, `ETF2  world: ...`, `ETF2  meanL <preset> ...` rows, an `ETF2  SUMMARY
## ...` line and `ETF2  RESULT checks=<n> fail=<n> cannot=<b>`; stderr carries `PROBE-CANNOT-RUN: ...` (headless, bad or
## missing argument, no world, no RenderWorkspace, fewer than two factions, watchdog after 2400 s). It writes
## `etf2_<preset>_<variant>.png` and `etf2_table.tsv` into `--out`. Exit 0 = every check held, 1 = a check failed, 2 =
## could not run (a failure outranks a cannot-run).

const RW := preload("res://shell/workspaces/render_workspace.gd")
const _OA := preload("res://shell/overlay_adjust.gd")
const VARIANTS := ["dark", "light", "pastel"]
## The five generated class inks (`labels.rs::LABEL_TYPOGRAPHY_DEFAULTS`), as
## `_overlaystyle_probe.gd` lists them.
const CLASS_INKS := ["#e0a34a", "#c8cbcd", "#a9adb0", "#6f9fb5", "#8d9296"]
const CREAM_HEX := "#f0e4c8"
## `_overlaystyle_probe.gd`'s two bars (label and class ink vs halo) and the scope's
## class-ink bar, reported beside it.
const LABEL_BAR := 4.5
const SCOPE_CLASS_BAR := 3.0
## A variant render must differ from its base's in more than this fraction of the
## map's sampled pixels (by more than 2 levels) -- a positive control that the rule
## reached the screen. A labelled judgement: 1 %, `_stylepresets_probe.gd`'s own
## preset-to-preset threshold.
const MOVED_FRACTION := 0.01
## Map pixels sampled for the mean-L metric: every STEP-th pixel on both axes.
const STEP := 3

var GRID := Vector2i(1024, 656)
var _out := ""
var _seed := 483920
var _only := ""
var _fail := 0
var _checks := 0
var _cannot := false
var _app: Node
var _vh: Control
var _br: Node
var _ov: Control
var _rw: Node
var _tiles: Array = []
var _ranges := {}
var _table: Array = []
var _lut := PackedFloat64Array()


func _ok(cond: bool, what: String) -> void:
	_checks += 1
	if cond:
		print("ETF2  ok    " + what)
	else:
		_fail += 1
		print("PROBE-FAIL ETF2  " + what)


func _frames(n: int) -> void:
	for i in n:
		await get_tree().process_frame


func _find(n: Node, script_file: String) -> Node:
	if n.get_script() != null and String(n.get_script().resource_path).ends_with(script_file):
		return n
	for c in n.get_children(true):
		var r := _find(c, script_file)
		if r != null:
			return r
	return null


func _parse_args() -> bool:
	var args := OS.get_cmdline_user_args()
	var i := 0
	while i < args.size():
		match args[i]:
			"--out":
				_out = args[i + 1]; i += 1
			"--seed":
				_seed = int(args[i + 1]); i += 1
			"--grid":
				var p := args[i + 1].split("x"); GRID = Vector2i(int(p[0]), int(p[1])); i += 1
			"--only":
				_only = args[i + 1]; i += 1
			_:
				printerr("PROBE-CANNOT-RUN: unknown argument %s" % args[i])
				return false
		i += 1
	if _out == "":
		printerr("PROBE-CANNOT-RUN: --out DIR is required")
		return false
	DirAccess.make_dir_recursive_absolute(_out)
	return true


## WCAG 2.1 contrast, alpha ignored (`MapOverlay.contrast_ratio`, the guard's own).
func _contrast(a: Color, b: Color) -> float:
	return _ov.contrast_ratio(Color(a.r, a.g, a.b), Color(b.r, b.g, b.b))


func _ready() -> void:
	if DisplayServer.get_name() == "headless":
		printerr("PROBE-CANNOT-RUN: headless -- run windowed.")
		get_tree().quit(2)
		return
	if not _parse_args():
		get_tree().quit(2)
		return
	get_tree().create_timer(2400.0).timeout.connect(func() -> void:
		printerr("PROBE-CANNOT-RUN: watchdog"); get_tree().quit(2))
	## sRGB-encoded byte -> linear light, for the metric (IEC 61966-2-1 EOTF).
	_lut.resize(256)
	for i in 256:
		var v := i / 255.0
		_lut[i] = v / 12.92 if v <= 0.04045 else pow((v + 0.055) / 1.055, 2.4)
	DisplayServer.window_set_size(Vector2i(1600, 1000))
	await _frames(2)
	_leg_rule()
	_app = load("res://shell/app.tscn").instantiate()
	add_child(_app)
	await get_tree().create_timer(1.0).timeout
	_vh = _app.viewport
	_br = _app.bridge
	_ov = _vh.overlay
	if _app.open_project_dialog != null:
		_app.open_project_dialog.hide()
	_br.generate({"seed": _seed, "width_km": 1200.0, "grid_w": GRID.x, "grid_h": GRID.y,
		"archetype": "", "villages": true, "sea_level": 0.42})
	var spins := 0
	while _br.generating and spins < 2400:
		await get_tree().create_timer(0.25).timeout
		spins += 1
	await get_tree().create_timer(1.0).timeout
	if _br.generating or _br.settlements().is_empty():
		printerr("PROBE-CANNOT-RUN: no generated world")
		get_tree().quit(2)
		return
	_br.labels_generate({"cull": {"on": false}})
	_vh.refresh_annotations()
	for l in ["settlements", "roads", "sea_routes", "provinces"]:
		_vh.set_layer_visible(l, true)
	_app.select_domain_category("cartography", "Style")
	await _frames(8)
	_rw = _find(_app, "render_workspace.gd")
	if _rw == null:
		printerr("PROBE-CANNOT-RUN: no RenderWorkspace")
		get_tree().quit(2)
		return
	_tiles = _rw.get("_preset_tiles")
	_ok(_tiles.size() == RW.STYLE_PRESETS.size() and Dictionary(_tiles[0]).has("chips")
		and Dictionary(_tiles[0]["chips"]).size() == 3,
		"every tile carries its three variant chips (%d tiles)" % _tiles.size())
	for row in _br.appearance_tunables():
		_ranges[String(row[0])] = [float(row[1]), float(row[2])]
	var fc: Array = _ov.get("_faction_colors")
	print("ETF2  world: %d settlements, %d factions, %d labels" % [_br.settlements().size(),
		fc.size(), _br.labels_render_list().size()])
	if fc.size() < 2:
		printerr("PROBE-CANNOT-RUN: fewer than two factions; the faction leg cannot answer")
		_cannot = true
	_vh.reset_view()
	await _settle()
	await _leg_renders()
	await _leg_look_coexistence()
	await _leg_history()
	await _leg_unknown()
	_finish()


# -- A: the rule, no render ---------------------------------------------------------

func _leg_rule() -> void:
	var base := PackedStringArray()
	for entry in RW.STYLE_PRESETS:
		if entry.size() > 3:
			for k in Dictionary(entry[3]):
				if not base.has(String(k)):
					base.append(String(k))
	var all: PackedStringArray = RW._preset_appearance_keys()
	var same := all.size() == base.size()
	for k in all:
		same = same and base.has(k)
	_ok(same, "A: the reset/snapshot key set is the base presets' own (%d keys, rule added none)" % all.size())
	for entry in RW.STYLE_PRESETS:
		var n := String(entry[0])
		_ok(RW.variant_treatment_for(n, "") == RW.overlay_treatment_for(n)
			and RW.variant_treatment_for(n, "sepia") == RW.overlay_treatment_for(n),
			"A: %s -- no variant and an unknown one are the base treatment" % n)
	## Antique: label ink (0.17, 0.11, 0.06) / halo (0.93, 0.86, 0.70). Its OkLab L is
	## ~0.25 / ~0.89 (computed by hand from Ottosson's matrices); mirrored, ~0.75 / ~0.11.
	var t: Dictionary = RW.variant_treatment_for("Antique", "dark")
	var li := RW.oklab_l(t["label_ink"])
	var lh := RW.oklab_l(t["label_halo"])
	_ok(li > 0.70 and li < 0.80 and lh > 0.06 and lh < 0.16,
		"A: Antique dark mirrors to pale ink L %.3f (0.70..0.80) on dark halo L %.3f (0.06..0.16)" % [li, lh])
	var night: Dictionary = RW.variant_treatment_for("Night", "dark")
	_ok(RW.oklab_l(night["label_ink"]) > RW.oklab_l(night["label_halo"]),
		"A: Night dark keeps its own (light-ink) polarity, unmirrored")
	var ink0: Color = RW.overlay_treatment_for("Print")["label_ink"]
	var ink1: Color = RW.variant_treatment_for("Print", "light")["label_ink"]
	var c0 := _chroma(ink0)
	var c1 := _chroma(ink1)
	_ok(c1 <= 0.35 * c0 + 0.002 and c1 > 0.0,
		"A: Print light keeps at most 0.35 of its label-ink chroma (%.4f of %.4f)" % [c1, c0])


func _chroma(c: Color) -> float:
	var lab: PackedFloat64Array = _OA.srgb_to_oklab(PackedFloat64Array([c.r * 255.0, c.g * 255.0, c.b * 255.0]))
	return sqrt(lab[1] * lab[1] + lab[2] * lab[2])


# -- B: 68 renders ---------------------------------------------------------------------

func _settle() -> void:
	await _frames(8)
	var t0 := Time.get_ticks_msec()
	while _vh.lod_pending() > 0 and Time.get_ticks_msec() - t0 < 20000:
		await get_tree().process_frame
	await get_tree().create_timer(0.5).timeout
	await _frames(4)


func _grab_map() -> Image:
	await RenderingServer.frame_post_draw
	var img := get_viewport().get_texture().get_image()
	img.convert(Image.FORMAT_RGB8)
	var r := Rect2i(_vh.get_global_rect())
	r = r.intersection(Rect2i(Vector2i.ZERO, img.get_size()))
	return img.get_region(r)


## Mean OkLab L over every STEP-th pixel of `img` (the map viewport's crop):
## linearise (IEC 61966-2-1), Ottosson's LMS matrix and cube root, L row only --
## `overlay_adjust.gd`'s own matrices, read from it rather than copied.
func _mean_l(img: Image) -> float:
	var d := img.get_data()
	var w := img.get_width()
	var h := img.get_height()
	var m: Array = _OA.LINEAR_SRGB_TO_LMS
	var o: Array = _OA.LMS_CUBE_ROOT_TO_OKLAB[0]
	var sum := 0.0
	var n := 0
	for y in range(0, h, STEP):
		for x in range(0, w, STEP):
			var i := (y * w + x) * 3
			var r := _lut[d[i]]
			var g := _lut[d[i + 1]]
			var b := _lut[d[i + 2]]
			var l := pow(m[0][0] * r + m[0][1] * g + m[0][2] * b, 1.0 / 3.0)
			var mm := pow(m[1][0] * r + m[1][1] * g + m[1][2] * b, 1.0 / 3.0)
			var s := pow(m[2][0] * r + m[2][1] * g + m[2][2] * b, 1.0 / 3.0)
			sum += o[0] * l + o[1] * mm + o[2] * s
			n += 1
	return sum / maxf(1.0, float(n))


## Fraction of sampled pixels differing by more than 2 levels in any channel.
func _moved(a: Image, b: Image) -> float:
	if a.get_size() != b.get_size():
		return 1.0
	var da := a.get_data()
	var db := b.get_data()
	var n := 0
	var moved := 0
	for i in range(0, da.size() - 2, 3 * STEP):
		n += 1
		if absi(da[i] - db[i]) > 2 or absi(da[i + 1] - db[i + 1]) > 2 or absi(da[i + 2] - db[i + 2]) > 2:
			moved += 1
	return float(moved) / maxf(1.0, float(n))


func _press_base(i: int) -> void:
	(_tiles[i]["button"] as Button).emit_signal("pressed")
	await _settle()


func _press_chip(i: int, v: String) -> void:
	(_tiles[i]["chips"][v] as Button).emit_signal("pressed")
	await _settle()


func _fname(n: String) -> String:
	return n.replace(" / ", "_").replace(" ", "_")


## The legibility and faction numbers for whatever is live now.
func _guards() -> Dictionary:
	var inks: Array = _ov.label_inks({"color": CREAM_HEX, "generated": false})
	var lab := _contrast(inks[0], inks[1])
	var cls := 99.0
	for hex in CLASS_INKS:
		var gi: Array = _ov.label_inks({"color": hex, "generated": true})
		cls = minf(cls, _contrast(gi[0], gi[1]))
	var ni: Array = _ov.settlement_name_inks()
	var nm := _contrast(ni[0], ni[1])
	var raw: Array = _ov.get("_faction_colors")
	var styled: Array = _ov.get("_styled_factions")
	var drawn: Array = styled if not styled.is_empty() else raw
	var de := float(_ov.min_pair_delta_e(drawn))
	var req := minf(float(_ov.get_script().PIN_MIN_DELTA_E), float(_ov.min_pair_delta_e(raw)))
	return {"label": lab, "class": cls, "name": nm, "de": de, "req_de": req,
		"mode": String(_ov.styled_factions_mode())}


func _leg_renders() -> void:
	var cal := {}
	for i in RW.STYLE_PRESETS.size():
		var pname := String(RW.STYLE_PRESETS[i][0])
		if _only != "" and pname != _only:
			continue
		await _press_base(i)
		var base_img := await _grab_map()
		base_img.save_png("%s/etf2_%s_base.png" % [_out, _fname(pname)])
		var base_ap: Dictionary = _br.appearance()
		var row := {"preset": pname, "base": _mean_l(base_img)}
		var g0 := _guards()
		row["base_g"] = g0
		for v in VARIANTS:
			await _press_chip(i, v)
			var img := await _grab_map()
			img.save_png("%s/etf2_%s_%s.png" % [_out, _fname(pname), v])
			row[v] = _mean_l(img)
			var g := _guards()
			row[v + "_g"] = g
			var tag := "%s %s" % [pname, v]
			_ok(_rw.get("_active_preset") == i and String(_rw.get("_active_variant")) == v,
				"B: %s -- the chip lit the variant" % tag)
			## Wiring: the engine holds what the rule computes from the base's read-back.
			var want: Dictionary = RW.variant_appearance(i, v, base_ap, _ranges)
			var live: Dictionary = _br.appearance()
			var wired := not want.is_empty()
			for k in want:
				wired = wired and live.has(k) and absf(float(live[k]) - float(want[k])) < 1e-4
			_ok(wired, "B: %s -- engine appearance equals the rule over the base (%d keys)" % [tag, want.size()])
			_ok(_ov.style_treatment() == RW.variant_treatment_for(pname, v),
				"B: %s -- the overlay carries the variant treatment" % tag)
			_ok(float(g["label"]) >= LABEL_BAR, "B: %s -- label ink vs halo %.2f >= 4.5" % [tag, g["label"]])
			_ok(float(g["class"]) >= LABEL_BAR, "B: %s -- weakest class ink vs halo %.2f >= 4.5 (scope bar 3.0)" % [tag, g["class"]])
			_ok(float(g["name"]) >= LABEL_BAR, "B: %s -- settlement name vs halo %.2f >= 4.5" % [tag, g["name"]])
			if not _cannot:
				_ok(float(g["de"]) >= float(g["req_de"]) - 0.0001,
					"B: %s -- factions min dE %.1f >= guard bar %.1f (mode %s)" % [tag, g["de"], g["req_de"], g["mode"]])
			var mv := _moved(base_img, img)
			_ok(mv > MOVED_FRACTION, "B: %s -- the map moved off the base (%.1f %% of samples)" % [tag, mv * 100.0])
			## Toggle off: the same chip again is the base preset.
			await _press_chip(i, v)
			var back: Dictionary = _br.appearance()
			var same := true
			for k in want:
				same = same and absf(float(back.get(k, NAN)) - float(base_ap.get(k, NAN))) < 1e-4
			_ok(same and String(_rw.get("_active_variant")) == "" and _rw.get("_active_preset") == i
				and _ov.style_treatment() == RW.overlay_treatment_for(pname),
				"B: %s -- pressing the lit chip again returns the base" % tag)
		_table.append(row)
		if pname == "Default" or pname == "Night":
			cal[pname] = row["base"]
		print("ETF2  meanL %-15s dark %.4f  base %.4f  light %.4f  pastel %.4f" % [pname,
			row["dark"], row["base"], row["light"], row["pastel"]])
	## Calibration (hand-checked screenshots: etf2_Default_base.png reads as a light
	## map, etf2_Night_base.png as a dark one).
	## With `--only` the two calibration presets are not rendered, and the label says so.
	var label := "meanL (uncalibrated in this --only run)"
	if cal.has("Default") and cal.has("Night"):
		label = "meanL (calibrated: Default %.3f = light map, Night %.3f = dark map)" % [cal["Default"], cal["Night"]]
		_ok(float(cal["Night"]) < float(cal["Default"]), "B: metric calibration -- " + label)
	for row in _table:
		var ord: bool = float(row["dark"]) < float(row["base"]) and float(row["base"]) < float(row["light"])
		_ok(ord, "B: %s -- %s dark %.3f < base %.3f < light %.3f" % [row["preset"], label,
			row["dark"], row["base"], row["light"]])
	_summary()


func _summary() -> void:
	var lines := PackedStringArray(["preset\tvariant\tmeanL\tlabel\tclass\tname\tminDE\treqDE\tmode"])
	var mins := {}
	var lsum := {"base": 0.0, "dark": 0.0, "light": 0.0, "pastel": 0.0}
	for row in _table:
		for v in ["base"] + VARIANTS:
			var g: Dictionary = row[v + "_g"]
			lsum[v] += float(row[v])
			lines.append("%s\t%s\t%.4f\t%.2f\t%.2f\t%.2f\t%.1f\t%.1f\t%s" % [row["preset"], v,
				row[v], g["label"], g["class"], g["name"], g["de"], g["req_de"], g["mode"]])
			if v == "base":
				continue
			for k in ["label", "class", "name", "de"]:
				mins[k] = minf(float(mins.get(k, 99.0)), float(g[k]))
	var f := FileAccess.open("%s/etf2_table.tsv" % _out, FileAccess.WRITE)
	if f != null:
		f.store_string("\n".join(lines) + "\n")
	var n := maxf(1.0, float(_table.size()))
	print("ETF2  SUMMARY %d presets x 3 variants: min label %.2f, min class %.2f, min name %.2f, min faction dE %.1f; mean L base %.4f dark %.4f light %.4f pastel %.4f" % [
		_table.size(), mins.get("label", 0.0), mins.get("class", 0.0), mins.get("name", 0.0),
		mins.get("de", 0.0), lsum["base"] / n, lsum["dark"] / n, lsum["light"] / n, lsum["pastel"] / n])


# -- C: the ET-F1 Look entry is untouched -----------------------------------------------

func _leg_look_coexistence() -> void:
	if not _br.adjust_api:
		print("ETF2  note: no engine adjustment API; leg C cannot answer")
		_cannot = true
		return
	var i := _idx("Antique")
	await _press_base(i)
	var look := "{\"entries\":[{\"kind\":{\"hsl\":{\"hue_deg\":20.0,\"saturation\":-0.3,\"lightness\":0.1}},\"enabled\":true,\"opacity\":1.0}]}"
	var r: Dictionary = _br.adjust_set("terrain", look)
	_ok(bool(r.get("ok", false)), "C: a Look entry was written to the terrain stack")
	var before := String(_br.adjust_get("terrain").get("stack", ""))
	var ov_before: String = _OA.get_stack_json()
	await _press_chip(i, "dark")
	var mid := String(_br.adjust_get("terrain").get("stack", ""))
	await _press_chip(i, "pastel")
	await _press_base(i)
	var after := String(_br.adjust_get("terrain").get("stack", ""))
	_ok(before != "" and before == mid and before == after and _OA.get_stack_json() == ov_before,
		"C: variant and base presses leave the Look entry and the overlay stack byte-identical")
	_br.adjust_set("terrain", "{\"entries\":[]}")


# -- D: the history label -----------------------------------------------------------------

func _leg_history() -> void:
	var i := _idx("Ink")
	await _press_base(i)
	var base_ap: Dictionary = _br.appearance()
	await _press_chip(i, "light")
	var lh = _app.look_history
	_ok(lh != null and String(lh.undo_label()) == "Style: Ink (Light)",
		"D: Edit > Undo names the variant (%s)" % (lh.undo_label() if lh != null else "no history"))
	if lh == null:
		return
	_app.look_undo()
	await _settle()
	var ap: Dictionary = _br.appearance()
	_ok(String(_rw.get("_active_variant")) == "" and _rw.get("_active_preset") == i
		and absf(float(ap.get("grade_saturation", NAN)) - float(base_ap.get("grade_saturation", NAN))) < 1e-4,
		"D: undo restores the base appearance and relights the base tile, no chip")
	## Redo must relight the variant's chip: the history's chrome carries it.
	_app.look_redo()
	await _settle()
	var chips: Dictionary = _tiles[i]["chips"]
	_ok(String(_rw.get("_active_variant")) == "light" and _rw.get("_active_preset") == i
		and _chip_lit(chips["light"]) and not _chip_lit(chips["dark"]),
		"D: redo relights the Light chip (and only it)")


## A chip is lit when `DccWidgets.set_segment_on()` gave it the accent ink.
func _chip_lit(b: Button) -> bool:
	return b.get_theme_color("font_color") == DccTheme.c("accent")


# -- E: an unknown variant is the base --------------------------------------------------

func _leg_unknown() -> void:
	var i := _idx("Woodcut")
	await _press_base(i)
	var base_ap: Dictionary = _br.appearance()
	_rw.callv("_apply_preset", [i, "sepia"])
	await _settle()
	var ap: Dictionary = _br.appearance()
	var same := true
	for k in RW._preset_appearance_keys():
		same = same and str(ap.get(k)) == str(base_ap.get(k))
	_ok(same and String(_rw.get("_active_variant")) == ""
		and _ov.style_treatment() == RW.overlay_treatment_for("Woodcut"),
		"E: an unknown variant ('sepia') applies the base preset")


func _idx(n: String) -> int:
	for i in RW.STYLE_PRESETS.size():
		if String(RW.STYLE_PRESETS[i][0]) == n:
			return i
	return -1


func _finish() -> void:
	var code := 1 if _fail > 0 else (2 if _cannot else 0)
	print("ETF2  RESULT checks=%d fail=%d cannot=%s" % [_checks, _fail, _cannot])
	get_tree().quit(code)
