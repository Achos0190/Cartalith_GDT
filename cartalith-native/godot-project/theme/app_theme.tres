[resource]
default_font_size = 14

Label/colors/font_color = Color(0.972549, 0.980392, 0.988235, 1)
Label/font_sizes/font_size = 13

Button/styles/normal = SubResource("SB_Button_Normal")
Button/styles/hover = SubResource("SB_Button_Hover")
Button/styles/pressed = SubResource("SB_Button_Pressed")
Button/styles/disabled = SubResource("SB_Button_Disabled")
Button/styles/focus = SubResource("SB_Button_Focus")
Button/colors/font_color = Color(0.972549, 0.980392, 0.988235, 1)
Button/colors/font_hover_color = Color(0.972549, 0.980392, 0.988235, 1)
Button/colors/font_pressed_color = Color(0.972549, 0.980392, 0.988235, 1)
Button/colors/font_disabled_color = Color(0.580392, 0.639216, 0.721569, 1)
Button/font_sizes/font_size = 13

CheckBox/styles/focus = SubResource("SB_Button_Focus")
CheckBox/colors/font_color = Color(0.972549, 0.980392, 0.988235, 1)
CheckBox/colors/font_hover_color = Color(0.972549, 0.980392, 0.988235, 1)
CheckBox/colors/font_pressed_color = Color(0.133333, 0.772549, 0.368627, 1)
CheckBox/font_sizes/font_size = 13

OptionButton/styles/normal = SubResource("SB_Button_Normal")
OptionButton/styles/hover = SubResource("SB_Button_Hover")
OptionButton/styles/pressed = SubResource("SB_Button_Pressed")
OptionButton/styles/disabled = SubResource("SB_Button_Disabled")
OptionButton/styles/focus = SubResource("SB_Button_Focus")
OptionButton/colors/font_color = Color(0.972549, 0.980392, 0.988235, 1)
OptionButton/font_sizes/font_size = 13

LineEdit/styles/normal = SubResource("SB_Field")
LineEdit/styles/focus = SubResource("SB_Field_Focus")
