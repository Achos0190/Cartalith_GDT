PrimaryButton/styles/hover = SubResource("SB_Primary_Hover")
PrimaryButton/styles/pressed = SubResource("SB_Primary_Pressed")
PrimaryButton/styles/disabled = SubResource("SB_Primary_Normal")
PrimaryButton/styles/focus = SubResource("SB_Primary_Focus")
PrimaryButton/colors/font_color = Color(0.058824, 0.090196, 0.164706, 1)
PrimaryButton/colors/font_hover_color = Color(0.058824, 0.090196, 0.164706, 1)
PrimaryButton/colors/font_pressed_color = Color(0.058824, 0.090196, 0.164706, 1)
