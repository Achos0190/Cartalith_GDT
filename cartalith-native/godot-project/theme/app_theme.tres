[gd_resource type="Theme" load_steps=20 format=3]

; Dark "technical dashboard" palette from the ui-ux-pro-max skill's
; --design-system search ("procedural generation control panel dashboard
; tool", density 8 / variance 4) -- background #0F172A, card #1B2336,
; slate primary/secondary #1E293B/#334155, accent #22C55E, foreground
; #F8FAFC, muted-foreground #94A3B8, border #475569, destructive #EF4444,
; focus ring #FFFFFF. Re-expressed as Godot StyleBoxFlat resources + Theme
; type variations so main.tscn nodes opt in with a single
; `theme_type_variation` string instead of per-node style overrides.
; Applied project-wide via project.godot [gui] theme/custom.
;
; Font: kept Godot's built-in default (Fira Sans/Fira Code was the
; skill's typography match, but sourcing + licensing real font files is
; deferred to a follow-up pass rather than guessed at here -- see
; CHANGELOG.md).

[sub_resource type="StyleBoxFlat" id="SB_HeaderBar"]
bg_color = Color(0.105882, 0.137255, 0.211765, 1)
border_width_bottom = 1
border_color = Color(0.278431, 0.333333, 0.411765, 1)
content_margin_left = 20.0
content_margin_top = 10.0
content_margin_right = 20.0
content_margin_bottom = 10.0

