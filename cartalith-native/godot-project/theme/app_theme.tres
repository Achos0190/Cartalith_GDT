LineEdit/colors/font_placeholder_color = Color(0.580392, 0.639216, 0.721569, 1)
LineEdit/font_sizes/font_size = 13

PanelContainer/styles/panel = SubResource("SB_OuterPanel")

HeaderBar/base_type = &"PanelContainer"
HeaderBar/styles/panel = SubResource("SB_HeaderBar")

SettingsCard/base_type = &"PanelContainer"
SettingsCard/styles/panel = SubResource("SB_SettingsCard")

PrimaryButton/base_type = &"Button"
