[resource]
default_font_size = 14

Label/colors/font_color = Color(0.164706, 0.125490, 0.082353, 1)
Label/font_sizes/font_size = 13

Button/styles/normal = SubResource("SB_Button_Normal")
Button/styles/hover = SubResource("SB_Button_Hover")
Button/styles/pressed = SubResource("SB_Button_Pressed")
Button/styles/disabled = SubResource("SB_Button_Disabled")
Button/styles/focus = SubResource("SB_Button_Focus")
Button/colors/font_color = Color(0.164706, 0.125490, 0.082353, 1)
Button/colors/font_hover_color = Color(0.164706, 0.125490, 0.082353, 1)
Button/colors/font_pressed_color = Color(0.164706, 0.125490, 0.082353, 1)
Button/colors/font_disabled_color = Color(0.427451, 0.372549, 0.278431, 1)
Button/font_sizes/font_size = 13

CheckBox/styles/focus = SubResource("SB_Button_Focus")
CheckBox/colors/font_color = Color(0.164706, 0.125490, 0.082353, 1)
CheckBox/colors/font_hover_color = Color(0.164706, 0.125490, 0.082353, 1)
CheckBox/colors/font_pressed_color = Color(0.690196, 0.498039, 0.247059, 1)
